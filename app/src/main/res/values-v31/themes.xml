<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MathRunner" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Disable white system splash screen and centered icon on Android 12+ -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_transparent</item>
        <item name="android:windowSplashScreenBackground">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
